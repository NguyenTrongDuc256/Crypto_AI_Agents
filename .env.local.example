# ============================================
# Crypto AI Dashboard - Frontend Environment Variables
# ============================================
# Copy file này thành .env.local và điền API keys của bạn
# Sau đó chạy: npm run dev

# ============================================
# LLM API Keys (Lấy từ các dịch vụ)
# ============================================

# Groq API Key (Free - 30 req/min)
# Lấy từ: https://console.groq.com
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Anthropic API Key (Paid - Claude)
# Lấy từ: https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Gemini API Key (Free - 15 req/min)
# Lấy từ: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=AIyour_gemini_api_key_here

# ============================================
# Backend API URL
# ============================================

# URL của backend API (Railway hoặc local)
# Nếu chạy local: http://localhost:8000
# Nếu dùng Railway: https://your-backend.up.railway.app
VITE_API_URL=http://localhost:8000

# ============================================
# Database (Supabase)
# ============================================

# Supabase Connection String
# Lấy từ: Supabase Dashboard → Settings → Database
VITE_DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# ============================================
# Trading Configuration
# ============================================

# Số dư ban đầu cho Paper Trading
VITE_INITIAL_BALANCE=100

# Rủi ro tối đa mỗi lệnh (2%)
VITE_MAX_RISK_PER_TRADE=0.02

# Số lệnh tối đa mở cùng lúc
VITE_MAX_OPEN_TRADES=3

# Đòn bẩy mặc định
VITE_DEFAULT_LEVERAGE=5

# ============================================
# Telegram Bot (Optional)
# ============================================

# Telegram Bot Token
# Lấy từ: @BotFather trên Telegram
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# CEO Chat ID
# Lấy từ: @userinfobot trên Telegram
VITE_TELEGRAM_CEO_CHAT_ID=your_chat_id_here

# ============================================
# Feature Flags
# ============================================

# Bật/tắt các tính năng
VITE_ENABLE_PAPER_TRADING=true
VITE_ENABLE_BACKTESTING=true
VITE_ENABLE_LIVE_TRADING=false
