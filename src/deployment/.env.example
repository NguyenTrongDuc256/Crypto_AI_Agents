# ============================================
# Crypto AI Trading System - Environment Variables
# ============================================

# LLM API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exchange API Keys (Trade only, NO withdraw!)
BINANCE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BINANCE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BINANCE_TESTNET=true

# Database Configuration
DB_USER=crypto_user
DB_PASSWORD=crypto_pass
DB_NAME=crypto_ai
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://crypto_user:crypto_pass@postgres:5432/crypto_ai

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=7234567890:AAHxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CEO_CHAT_ID=123456789

# Trading Configuration
INITIAL_BALANCE=100.0
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_TRADES=3
DEFAULT_LEVERAGE=5
TRADING_SYMBOL=BTC/USDT
TRADING_MODE=paper

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SSL/TLS (for production)
SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
SSL_PRIVATE_KEY=/etc/nginx/ssl/privkey.pem
